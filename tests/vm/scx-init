#!/bin/sh
# Init of the scx test VM: load the module, run upstream's scx_simple on it
# with a workload, unload, and look for complaints.
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
result=0
/load-module /scx.ko || { echo DS_SCX_LOAD_FAIL; dmesg | tail -20; poweroff -f; }
runs() { n=0; for v in $(grep ctxt_switches /proc/$1/status | cut -f2); do n=$((n + v)); done; echo $n; }
echo "state=$(cat /sys/kernel/sched_ext/state 2>&1)"
# With schedstats on, the idle class's set_next_task branches past the place
# our probe sits, as it does on a Galaxy S24.
echo 1 > /proc/sys/kernel/sched_schedstats

/scx-run /scx_simple > /simple.log 2>&1 & simple=$!
sleep 8
grep -q enabled /sys/kernel/sched_ext/state && echo "PORT loaded: PASS" || { echo "PORT loaded: FAIL"; result=1; }
pids=
for i in 1 2 3; do sh -c 'while :; do :; done' & pids="$pids $!"; done
for i in 1 2 3; do sh -c 'while :; do usleep 1000; done' & pids="$pids $!"; done
sleep 2
for p in $pids; do eval "t$p=$(runs $p)"; done
sleep 5
starved=0
for p in $pids; do eval "old=\$t$p"; [ $(($(runs $p) - old)) -gt 0 ] || starved=$((starved + 1)); done
[ "$starved" = 0 ] && echo "PORT every task ran: PASS" || { echo "PORT every task ran: FAIL ($starved starved)"; result=1; }
i=0; while [ $i -lt 300 ]; do echo $i | cat | grep -q . ; i=$((i + 1)); done
echo "PORT fork and pipe burst: PASS"
renice 5 $pids >/dev/null 2>&1; taskset -p 1 $(echo $pids | cut -d' ' -f1) >/dev/null 2>&1
sleep 2
echo "PORT nice and affinity: PASS"
# The core takes a task to rt and hands it back to fair by itself: it must
# keep running, and the scheduler must not be upset by either.
first=$(echo $pids | cut -d' ' -f1)
i=0; while [ $i -lt 20 ]; do chrt -f -p 1 $first; chrt -o -p 0 $first; i=$((i + 1)); done >/dev/null 2>&1
old=$(runs $first); sleep 2
[ $(($(runs $first) - old)) -gt 0 ] && grep -q enabled /sys/kernel/sched_ext/state && echo "PORT to rt and back: PASS" || { echo "PORT to rt and back: FAIL"; result=1; }
kill -INT $simple
wait $simple
tail -8 /simple.log | sed "s/^/PORT| /"
grep -Eq "global=[1-9][0-9]+" /simple.log && echo "PORT queue in use: PASS" || { echo "PORT queue in use: FAIL"; result=1; }
grep -q disabled /sys/kernel/sched_ext/state && echo "PORT unloaded: PASS" || { echo "PORT unloaded: FAIL"; result=1; }
for p in $pids; do eval "t$p=$(runs $p)"; done
sleep 3
starved=0
for p in $pids; do eval "old=\$t$p"; [ $(($(runs $p) - old)) -gt 0 ] || starved=$((starved + 1)); done
[ "$starved" = 0 ] && echo "PORT tasks carry on as fair: PASS" || { echo "PORT tasks carry on as fair: FAIL ($starved starved)"; result=1; }
kill $pids
sleep 1
# A CPU going away while a scheduler is loaded: scx_simple does not follow
# hotplug, so upstream ends it, and everything must be fair again.
/scx-run /scx_simple > /simple2.log 2>&1 & simple=$!
sleep 6
echo 0 > /sys/devices/system/cpu/cpu1/online
sleep 3
echo 1 > /sys/devices/system/cpu/cpu1/online
sleep 2
kill -INT $simple 2>/dev/null
wait $simple
tail -2 /simple2.log | sed "s/^/PORT| /"
grep -q disabled /sys/kernel/sched_ext/state && [ "$(cat /sys/devices/system/cpu/online)" = 0-1 ] && echo "PORT cpu hotplug: PASS" || { echo "PORT cpu hotplug: FAIL"; result=1; }
# Other upstream schedulers, where built: does this kernel's verifier take
# them, and do they run. Reported, not counted.
for s in /scx_*; do
    [ $s = /scx_simple ] && continue
    /scx-run $s > /try.log 2>&1 & try=$!
    # the verifier walks this kernel's bounded loops round by round, which
    # takes a while under emulation
    i=0; while [ $i -lt 40 ] && ! grep -q enabled /sys/kernel/sched_ext/state; do sleep 1; i=$((i + 1)); done
    sleep 6
    state=$(cat /sys/kernel/sched_ext/state)
    kill -INT $try 2>/dev/null; wait $try
    echo "TRY $s: $state after ${i}s"
    tail -4 /try.log | sed "s/^/TRY| /"
    [ "$state" = enabled ] || grep -vE "not found in kernel, skipping|fentry cannot attach|associate" /try.log | grep -E "libbpf|error|Error|BUG|invalid|R[0-9]|[0-9]+: \(" | tail -12 | sed "s/^/TRY| /"
done
dmesg | grep -E 'sched_ext|droidspaces|BUG|WARNING|Oops|panic|bad: scheduling|rcu.*stall' | tail -30
dmesg | grep -q 'ran without having been picked' && { echo 'PORT every running task was set: FAIL'; result=1; } || echo 'PORT every running task was set: PASS'
echo "DS_SCX_VM_RESULT=$result"
poweroff -f
