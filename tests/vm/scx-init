#!/bin/sh
# Init of the scx test VM: load the module, run tests/vm/scx.c next to
# fair and ext load, then look for scheduler complaints.
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
P=/sys/module/droidspaces_scx/parameters
result=0
/load-module /scx.ko || { echo DS_SCX_LOAD_FAIL; poweroff -f; }
ticks() { cut -d' ' -f14 /proc/$1/stat; }
# A task that mostly sleeps gathers no ticks, but every turn it gets ends in a
# context switch.
runs() { n=0; for v in $(grep ctxt_switches /proc/$1/status | cut -f2); do n=$((n + v)); done; echo $n; }

# Three spinners on two CPUs, all in the class: each must keep getting time.
pids=
for i in 1 2 3; do sh -c 'while :; do :; done' & pids="$pids $!"; done
for p in $pids; do echo $p > $P/attach || result=1; done
sleep 1
for p in $pids; do eval "t$p=$(ticks $p)"; done
sleep 3
for p in $pids; do
    eval "old=\$t$p"
    [ $(($(ticks $p) - old)) -gt 50 ] && echo "SCX spinner $p shares: PASS" || { echo "SCX spinner $p shares: FAIL"; result=1; }
done
/scx-test || result=1
# The same again while a fair task hogs a CPU. The class sits below fair, so a
# task pinned to the hog's CPU waits until the watchdog hands it back to fair.
# The run then fails its own checks: what counts is that it ends, that the
# watchdog fired, and that nothing broke.
sh -c 'while :; do :; done' & hog=$!
timeout 120 /scx-test >/dev/null
[ $? -lt 124 ] && [ "$(cat $P/nr_fallbacks)" -gt 0 ] && echo "SCX under fair load: PASS" || { echo "SCX under fair load: FAIL"; result=1; }
kill $hog $pids
sleep 1

# A BPF scheduler, scx_simple's weighted vtime queue: three spinners and three sleepers on two
# CPUs must all keep getting time through its queue, and when it is unloaded
# while they wait in that queue they must carry on without it.
/scx-load /scx-sched.bpf.o 12 > /bpf.log 2>&1 & loader=$!
sleep 3
bpids=
for i in 1 2 3; do sh -c 'while :; do :; done' & bpids="$bpids $!"; done
for i in 1 2 3; do sh -c 'while :; do usleep 1000; done' & bpids="$bpids $!"; done
for p in $bpids; do echo $p > $P/attach || result=1; done
sleep 2
for p in $bpids; do eval "t$p=$(runs $p)"; done
sleep 4
starved=0
for p in $bpids; do eval "old=\$t$p"; [ $(($(runs $p) - old)) -gt 0 ] || starved=$((starved + 1)); done
wait $loader
cat /bpf.log
[ "$starved" = 0 ] && echo "SCX-BPF every task ran: PASS" || { echo "SCX-BPF every task ran: FAIL ($starved starved)"; result=1; }
grep -q "SCX-BPF detach: PASS" /bpf.log && grep -Eq "consumed=[1-9][0-9]+ running=[1-9]" /bpf.log && echo "SCX-BPF queue in use: PASS" || { echo "SCX-BPF queue in use: FAIL"; result=1; }
for p in $bpids; do eval "t$p=$(runs $p)"; done
sleep 3
starved=0
for p in $bpids; do eval "old=\$t$p"; [ $(($(runs $p) - old)) -gt 0 ] || starved=$((starved + 1)); done
[ "$starved" = 0 ] && echo "SCX-BPF tasks survive unload: PASS" || { echo "SCX-BPF tasks survive unload: FAIL ($starved starved)"; result=1; }
grep -q "SCX-BPF exit_kind=64" /bpf.log && echo "SCX-BPF exit reported: PASS" || { echo "SCX-BPF exit reported: FAIL"; result=1; }
echo "kfunc_errors=$(cat $P/nr_kfunc_errors)"
[ "$(cat $P/nr_kfunc_errors)" = 0 ] || result=1
kill $bpids
sleep 1
# Upstream's own scx_simple, source and loader unmodified.
if [ -x /scx_simple ]; then
    /scx-run /scx_simple > /simple.log 2>&1 & simple=$!
    sleep 6
    upids=
    for i in 1 2 3; do sh -c 'while :; do :; done' & upids="$upids $!"; done
    for i in 1 2 3; do sh -c 'while :; do usleep 1000; done' & upids="$upids $!"; done
    # nothing to attach: scx_simple has every user task already
    sleep 2
    for p in $upids; do eval "t$p=$(runs $p)"; done
    sleep 5
    starved=0
    for p in $upids; do eval "old=\$t$p"; [ $(($(runs $p) - old)) -gt 0 ] || starved=$((starved + 1)); done
    grep -q enabled /sys/kernel/sched_ext/state && echo "SCX-UP loaded: PASS" || { echo "SCX-UP loaded: FAIL"; result=1; }
    # scx_simple takes every user task. This shell is one, and so is anything
    # it starts now: attaching either must be refused as already attached.
    [ "$(cat $P/switched_all)" = Y ] && ! echo $$ > $P/attach 2>/dev/null && echo "SCX-UP all tasks switched: PASS" || { echo "SCX-UP all tasks switched: FAIL"; result=1; }
    sh -c 'while :; do :; done' & born=$!
    sleep 1
    ! echo $born > $P/attach 2>/dev/null && echo "SCX-UP new task is born in the class: PASS" || { echo "SCX-UP new task is born in the class: FAIL"; result=1; }
    kill $born
    # The whole system on the BPF scheduler: a burst of forks, pipes and exits.
    i=0; while [ $i -lt 300 ]; do echo $i | cat | grep -q . ; i=$((i + 1)); done
    echo "SCX-UP fork and pipe burst: PASS"
    kill -INT $simple
    wait $simple
    tail -12 /simple.log | sed "s/^/SCX-UP| /"
    [ "$starved" = 0 ] && echo "SCX-UP every task ran: PASS" || { echo "SCX-UP every task ran: FAIL ($starved starved)"; result=1; }
    grep -Eq "global=[1-9][0-9]+" /simple.log && echo "SCX-UP queue in use: PASS" || { echo "SCX-UP queue in use: FAIL"; result=1; }
    kill $upids
    sleep 1
    # Unloading gives every task back to fair.
    sh -c 'while :; do :; done' & back=$!
    sleep 1
    [ "$(cat $P/switched_all)" = N ] && echo $back > $P/attach && echo $back > $P/detach && echo "SCX-UP tasks returned to fair: PASS" || { echo "SCX-UP tasks returned to fair: FAIL"; result=1; }
    kill $back
fi
echo "attaches=$(cat $P/nr_attaches) picks=$(cat $P/nr_picks) enqueues=$(cat $P/nr_enqueues) pulls=$(cat $P/nr_pulls) fallbacks=$(cat $P/nr_fallbacks)"
[ "$(cat $P/nr_picks)" -gt 1000 ] || result=1
dmesg | grep -E 'droidspaces|BUG|WARNING|Oops|panic|bad: scheduling|rcu.*stall'
echo "DS_SCX_VM_RESULT=$result"
poweroff -f
