+/**
+ * phoc_input_method_relay_get_active_text_input:
+ * @relay: The input method relay
+ *
+ * Returns: (nullable): The text input of the focused client if it is enabled.
+ */
+struct wlr_text_input_v3 *
+phoc_input_method_relay_get_active_text_input (PhocInputMethodRelay *relay)
+{
+  PhocTextInput *text_input;
+
+  wl_list_for_each (text_input, &relay->text_inputs, link) {
+    if (text_input->input->focused_surface && text_input->input->current_enabled)
+      return text_input->input;
+  }
+  return NULL;
+}
