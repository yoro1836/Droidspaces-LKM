diff --git a/src/anland/text-stub.c b/src/anland/text-stub.c
new file mode 100644
index 0000000..028f0a8
--- /dev/null
+++ b/src/anland/text-stub.c
@@ -0,0 +1,42 @@
+/*
+ * Stand-in for mango's text adapter, which feeds text typed on the Android
+ * keyboard into mango's own input-method relay. Phoc's relay is a different
+ * type, and Phosh brings its own on-screen keyboard, so committed text from
+ * the Android side is dropped here. Key events still arrive as key events.
+ */
+#include "text.h"
+
+#include <stddef.h>
+
+struct mango_anland_text { int unused; };
+
+struct mango_anland_text *
+mango_anland_text_create (struct wl_event_loop *loop, struct wlr_seat *seat)
+{
+  static struct mango_anland_text text;
+
+  (void)loop;
+  (void)seat;
+  /* The backend refuses to start without one. */
+  return &text;
+}
+
+bool
+mango_anland_text_submit (struct mango_anland_text *text, struct mango_input_method_relay *relay,
+                          const char *utf8, size_t length)
+{
+  (void)text; (void)relay; (void)utf8; (void)length;
+  return true;
+}
+
+bool
+mango_anland_text_handle_key (struct mango_anland_text *text, struct wlr_keyboard *keyboard,
+                              const struct wlr_keyboard_key_event *event)
+{
+  (void)text; (void)keyboard; (void)event;
+  return false;
+}
+
+void mango_anland_text_set_ime_grab (struct mango_anland_text *text, bool grabbed) { (void)text; (void)grabbed; }
+void mango_anland_text_reset (struct mango_anland_text *text) { (void)text; }
+void mango_anland_text_destroy (struct mango_anland_text *text) { (void)text; }
