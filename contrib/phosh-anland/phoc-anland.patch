+/*
+ * What mango's text adapter (text.c) wants from mango's text-input relay:
+ * whether a client has text input switched on, and a way to hand it a string.
+ * Phoc's relay answers both, see glue.c.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+struct wlr_text_input_v3;
+
+struct mango_input_method_relay {
+  struct wlr_text_input_v3 *active_text_input;
+};
+
+bool mango_text_input_commit_utf8 (struct mango_input_method_relay *relay, const char *text, size_t length);
