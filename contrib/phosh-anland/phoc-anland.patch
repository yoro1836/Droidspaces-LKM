diff --git a/src/anland/glue.c b/src/anland/glue.c
new file mode 100644
index 0000000..5f8d959
--- /dev/null
+++ b/src/anland/glue.c
@@ -0,0 +1,30 @@
+/* Phoc's side of mango/common/server.h. */
+#include "phoc-config.h"
+
+#include "cursor.h"
+#include "input.h"
+#include "seat.h"
+#include "server.h"
+
+#include "mango/common/server.h"
+
+#undef server
+
+struct phoc_anland_server *
+phoc_anland_server (void)
+{
+  static struct phoc_anland_server state;
+  PhocServer *phoc = phoc_server_get_default ();
+  PhocInput *input = phoc_server_get_input (phoc);
+  /* The backend hooks the seat's selection and focus signals when it starts,
+   * which is before any input device has asked for a seat. Asking by name
+   * creates it. */
+  PhocSeat *seat = input ? phoc_input_get_seat (input, "seat0") : NULL;
+  PhocCursor *cursor = seat ? phoc_seat_get_cursor (seat) : NULL;
+
+  state.display = phoc_server_get_wl_display (phoc);
+  state.seat = seat ? seat->seat : NULL;
+  state.active_constraint = cursor ? cursor->active_constraint : NULL;
+  state.input_method_relay = NULL;
+  return &state;
+}
diff --git a/src/anland/mango/common/server.h b/src/anland/mango/common/server.h
new file mode 100644
index 0000000..ba71a47
--- /dev/null
+++ b/src/anland/mango/common/server.h
@@ -0,0 +1,23 @@
+/*
+ * The Anland backend was written inside mango and reads four things off
+ * mango's global "server". Phoc has no such struct, so this stands in for
+ * it: the fields are filled from phoc's live state on every access.
+ */
+#pragma once
+
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/types/wlr_pointer_constraints_v1.h>
+
+struct mango_input_method_relay;
+
+struct phoc_anland_server {
+  struct wl_display                *display;
+  struct wlr_seat                  *seat;
+  struct wlr_pointer_constraint_v1 *active_constraint;
+  struct mango_input_method_relay  *input_method_relay;
+};
+
+struct phoc_anland_server *phoc_anland_server (void);
+
+#define server (*phoc_anland_server ())
