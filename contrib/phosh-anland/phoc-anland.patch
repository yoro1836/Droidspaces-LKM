diff --git a/src/anland/unhook.c b/src/anland/unhook.c
new file mode 100644
index 0000000..98ba159
--- /dev/null
+++ b/src/anland/unhook.c
@@ -0,0 +1,37 @@
+/*
+ * The backend listens on the seat for selection and focus changes and only
+ * lets go in its own destroy. Mango destroys the backend first. Phoc destroys
+ * its seats first, and wlroots asserts that nobody is still listening, so
+ * phoc aborted on every exit. Let go when phoc is about to drop its input.
+ */
+#include "internal.h"
+#include "phoc-anland.h"
+
+static struct anland_backend *created;
+
+struct wlr_backend *
+phoc_anland_backend_create (struct wl_event_loop *loop, const char *socket_path)
+{
+  struct wlr_backend *base = mango_anland_backend_create (loop, socket_path);
+
+  created = base ? wl_container_of (base, created, base) : NULL;
+  /* Phoc maps a touch device onto the output it names and otherwise onto
+   * the whole layout, where a rotated or scaled output no longer lines up
+   * with the finger. wlr_touch_finish() frees the name. */
+  if (created)
+    created->touch.output_name = strdup ("ANLAND-1");
+  return base;
+}
+
+void
+phoc_anland_backend_unhook_seat (void)
+{
+  if (!created)
+    return;
+  if (created->selection_listener_set)
+    wl_list_remove (&created->selection_listener.link);
+  if (created->focus_listener_set)
+    wl_list_remove (&created->focus_change.link);
+  created->selection_listener_set = created->focus_listener_set = false;
+  created = NULL;
+}
