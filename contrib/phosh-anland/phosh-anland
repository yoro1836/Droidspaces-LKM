#!/usr/bin/env bash
# Phosh on an Android surface through Anland. Runs in the foreground as the
# desktop user, with the phoc from build.sh in place of the system one.
set -uo pipefail
PREFIX=${PHOC_ANLAND_PREFIX:-/usr/lib/phoc-anland}
[[ -x "$PREFIX/bin/phoc" ]] || { echo "phosh-anland: run build.sh first, no phoc in $PREFIX" >&2; exit 1; }
command -v gnome-session >/dev/null || { echo "phosh-anland: install the phosh package" >&2; exit 1; }

export ANLAND=1 ANLAND_SOCKET=${ANLAND_SOCKET:-/run/display.sock}
export ANLAND_DRM_DEVICE=${ANLAND_DRM_DEVICE:-/dev/dri/renderD128}
export WLR_RENDER_DRM_DEVICE=${WLR_RENDER_DRM_DEVICE:-$ANLAND_DRM_DEVICE}
[[ -S "$ANLAND_SOCKET" ]] || { echo "phosh-anland: no Anland socket at $ANLAND_SOCKET" >&2; exit 1; }

# This phoc's own settings schema, in case the system phoc is another version.
export GSETTINGS_SCHEMA_DIR=$PREFIX/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}
# Mesa's GL driver for this GPU family wants a newer kernel interface than an
# Android kernel has, while its Vulkan driver works. So the compositor renders
# with Vulkan, and GL programs in the session go through Zink on top of it.
export WLR_RENDERER=${WLR_RENDERER:-vulkan}
export MESA_LOADER_DRIVER_OVERRIDE=${MESA_LOADER_DRIVER_OVERRIDE:-zink}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Phosh:GNOME XDG_SESSION_DESKTOP=phosh
export PULSE_SERVER=${PULSE_SERVER:-unix:$XDG_RUNTIME_DIR/pulse/native}

ini=/usr/share/phosh/phoc.ini
[[ -f /etc/phosh/phoc.ini ]] && ini=/etc/phosh/phoc.ini
# Same line as Phosh's own phosh-session, minus the DRM and libinput backends.
run=()
[[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || run=(dbus-run-session --)
exec "${run[@]}" "$PREFIX/bin/phoc" -S -C "$ini" -E "${PHOSH_SESSION_BIN:-gnome-session} --session=phosh"
